mod math.{add, div} as m;

fn main() int {
    let (a, b) = {
        let x = m.min(int, 0, div(int, 0, 1)?);
        let y = m.max(int, x, add(int, x, 1));
        let z = match @isSameType(@typeOf(x), int) {
            | true -> 1, | false -> 0
        };
        :(x/y, x/z)
    };
    :a * b
}

